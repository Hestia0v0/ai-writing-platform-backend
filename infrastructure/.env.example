DEEPSEEK_API_KEY=
# Email of the account to auto-grant super_admin. Checked at api_gateway
# startup and on every register/login for that email — works regardless of
# whether this var is set before or after the account first registers.
SUPER_ADMIN_EMAIL=
POSTGRES_DSN=postgresql://platform:YOUR_URL_ENCODED_PASSWORD@pgm-7xvh12647crp1d138o.pg.rds.aliyuncs.com:5432/platform?sslmode=disable
DATABASE_URL=postgresql://platform:YOUR_URL_ENCODED_PASSWORD@pgm-7xvh12647crp1d138o.pg.rds.aliyuncs.com:5432/platform?sslmode=disable
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
# Stripe sandbox values only. Never put sk_live_ credentials in this project.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_BASIC=price_...
STRIPE_PRICE_PRO=price_...
# Checkout/Portal return target. Use the canonical Vercel production URL in production.
FRONTEND_URL=http://localhost:5173
# Comma-separated, for example: http://localhost:5173,https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173

# Email verification (QQ Mail example: use an SMTP authorization code,
# not the mailbox login password).
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=AI Writing Platform
SMTP_USE_SSL=true
SMTP_TIMEOUT_SECONDS=10
EMAIL_CODE_TTL_SECONDS=600
EMAIL_CODE_COOLDOWN_SECONDS=60
EMAIL_CODE_MAX_ATTEMPTS=5

# ── Caddy (production: docker-compose.prod.yml at repository root) ───────
# DOMAIN=:80 for HTTP-only; set to api.example.com for automatic HTTPS.
DOMAIN=:80
ACME_EMAIL=

# ── Agents Service (optional model overrides) ──────────────────────────────
# All default to deepseek-chat. Override to use a different model per agent.
GUARDRAIL_MODEL=deepseek-chat
DRAFTING_MODEL=deepseek-chat
EVAL_MODEL=deepseek-chat
REFINEMENT_MODEL=deepseek-chat

# ── Evaluation Panel — fallback LLM chain & arbitration (see agents/evaluation/_base.py) ──
# Second-tier DeepSeek model tried when the primary EVAL_MODEL call fails.
EVAL_FALLBACK_MODEL=deepseek-reasoner
# Cross-provider fallback, tried only if the DeepSeek tiers above both fail.
# Leave ANTHROPIC_API_KEY empty to skip this link in the chain entirely.
ANTHROPIC_API_KEY=
EVAL_FALLBACK_ANTHROPIC_MODEL=claude-haiku-4-5
# Population stdev (0-25 scale) across the 4 rubric sub-scores above which the
# Consistency Arbiter agent re-checks the total (see agents/evaluation/arbiter.py).
ARBITRATION_STDEV_THRESHOLD=6.0
